generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./database_erd.svg"
  theme    = "forest" 
}
datasource db {
  provider = "postgresql"
}

model User {
  id                   Int               @id @default(autoincrement())
  username             String            @unique
  email                String            @unique
  password_hash        String
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  two_factor_secret    String?
  two_factor_confirmed Boolean           @default(false)
  avatar_color         String?           @db.VarChar(7)
  full_name            String?           @db.VarChar(100)
  job_title            String?           @db.VarChar(100)
  last_login           DateTime?         @default(now())
  activityLogs         ActivityLog[]
  announcements        Announcement[]
  comments             Comment[]
  documentVersions     DocumentVersion[] @relation("DocumentVersionCreator")
  documents            documents[]
  lockedDocuments      documents[]       @relation("DocumentLockOwner")
  fileVersions         FileVersion[]     @relation("FileVersionUploader")
  lockedFiles          File[]            @relation("FileLockOwner")
  files                File[]            @relation("FileUploader")
  folders              Folder[]
  sharedLinks          SharedLink[]
  teams                TeamMember[]

  @@map("users")
}

model Team {
  id                  Int            @id @default(autoincrement())
  name                String
  description         String?
  owner_id            Int
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  invite_code         String?        @unique @db.VarChar(8)
  invite_code_enabled Boolean?       @default(true)
  activityLogs        ActivityLog[]
  ai_cache            ai_cache[]
  announcements       Announcement[]
  comments            Comment[]
  documents           documents[]
  files               File[]
  folders             Folder[]
  shared_links        SharedLink[]
  members             TeamMember[]

  @@map("teams")
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  team_id    Int
  user_id    Int
  role       String   @default("viewer")
  created_at DateTime @default(now())
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

model Folder {
  id               Int          @id @default(autoincrement())
  team_id          Int
  parent_folder_id Int?
  name             String
  created_by       Int
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  is_deleted       Boolean      @default(false)
  documents        documents[]
  files            File[]
  creator          User         @relation(fields: [created_by], references: [id])
  parent           Folder?      @relation("FolderChildren", fields: [parent_folder_id], references: [id])
  children         Folder[]     @relation("FolderChildren")
  team             Team         @relation(fields: [team_id], references: [id], onDelete: Cascade)
  shared_links     SharedLink[]

  @@map("folders")
}

model File {
  id               Int           @id @default(autoincrement())
  team_id          Int
  folder_id        Int?
  filename         String
  original_name    String
  file_size        Int
  mime_type        String
  storage_path     String
  hash             String?
  uploaded_by      Int
  is_deleted       Boolean       @default(false)
  deleted_at       DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  lockOwnerUserId  Int?
  lockToken        String?       @db.VarChar(36)
  lockExpiresAt    DateTime?
  editingStartedAt DateTime?
  encryption_iv    String?       @db.VarChar(32)
  yjs_last_saved   DateTime?
  yjs_state        Bytes?
  comments         Comment[]
  versions         FileVersion[]
  folder           Folder?       @relation(fields: [folder_id], references: [id])
  lockOwner        User?         @relation("FileLockOwner", fields: [lockOwnerUserId], references: [id])
  team             Team          @relation(fields: [team_id], references: [id], onDelete: Cascade)
  uploader         User          @relation("FileUploader", fields: [uploaded_by], references: [id])
  shared_links     SharedLink[]

  @@index([lockExpiresAt], map: "idx_files_lock_expiry")
  @@map("files")
}

model FileVersion {
  id             Int      @id @default(autoincrement())
  file_id        Int
  version_number Int
  storage_path   String
  file_size      Int
  uploaded_by    Int
  created_at     DateTime @default(now())
  encryption_iv  String?  @db.VarChar(32)
  version_name   String?  @db.VarChar(255)
  yjs_state      Bytes?
  file           File     @relation(fields: [file_id], references: [id], onDelete: Cascade)
  uploader       User     @relation("FileVersionUploader", fields: [uploaded_by], references: [id])

  @@map("file_versions")
}

model Comment {
  id          Int        @id @default(autoincrement())
  file_id     Int?
  team_id     Int
  user_id     Int
  content     String
  resolved    Boolean    @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?
  is_deleted  Boolean    @default(false)
  document_id Int?
  documents   documents? @relation(fields: [document_id], references: [id], onDelete: Cascade)
  file        File?      @relation(fields: [file_id], references: [id], onDelete: Cascade)
  team        Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [user_id], references: [id])

  @@map("comments")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  team_id     Int?
  user_id     Int?
  action      String
  target_type String?
  target_id   Int?
  metadata    Json?
  ip          String?
  userAgent   String?
  created_at  DateTime @default(now())
  team        Team?    @relation(fields: [team_id], references: [id])
  user        User?    @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}

model SharedLink {
  id              Int        @id @default(autoincrement())
  file_id         Int?
  created_by      Int
  token           String     @unique
  password_hash   String?
  expiration_date DateTime?
  download_limit  Int?
  downloads_count Int        @default(0)
  created_at      DateTime   @default(now())
  team_id         Int
  document_id     Int?
  folder_id       Int?
  creator         User       @relation(fields: [created_by], references: [id])
  documents       documents? @relation(fields: [document_id], references: [id], onDelete: Cascade)
  files           File?      @relation(fields: [file_id], references: [id], onDelete: Cascade)
  folders         Folder?    @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  teams           Team       @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("shared_links")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  teamId    Int
  authorId  Int
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model ai_cache {
  id         Int      @id @default(autoincrement())
  team_id    Int
  feature    String   @db.VarChar(50)
  target_id  Int?
  result     String
  created_at DateTime @default(now())
  expires_at DateTime
  teams      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, feature, target_id])
  @@index([team_id, feature])
}

model documents {
  id              Int               @id @default(autoincrement())
  team_id         Int
  folder_id       Int?
  title           String            @default("Untitled Document")
  created_by      Int
  yjs_state       Bytes?
  last_saved      DateTime?
  is_deleted      Boolean           @default(false)
  deleted_at      DateTime?
  created_at      DateTime          @default(now())
  updated_at      DateTime
  lockExpiresAt   DateTime?
  lockOwnerUserId Int?
  lockToken       String?           @db.VarChar(36)
  comments        Comment[]
  versions        DocumentVersion[]
  users           User              @relation(fields: [created_by], references: [id])
  folders         Folder?           @relation(fields: [folder_id], references: [id])
  lockOwner       User?             @relation("DocumentLockOwner", fields: [lockOwnerUserId], references: [id])
  teams           Team              @relation(fields: [team_id], references: [id], onDelete: Cascade)
  shared_links    SharedLink[]

  @@index([lockExpiresAt], map: "idx_documents_lock_expiry")
}

model DocumentVersion {
  id           Int       @id @default(autoincrement())
  document_id  Int
  version_name String?   @db.VarChar(255)
  yjs_state    Bytes
  created_by   Int
  created_at   DateTime  @default(now())
  creator      User      @relation("DocumentVersionCreator", fields: [created_by], references: [id])
  document     documents @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

model token_blacklist {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}
