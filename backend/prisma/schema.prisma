generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int            @id @default(autoincrement())
  username             String         @unique
  email                String         @unique
  password_hash        String
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  two_factor_secret    String?
  two_factor_confirmed Boolean        @default(false)
  activityLogs         ActivityLog[]
  announcements        Announcement[]
  comments             Comment[]
  fileVersions         FileVersion[]  @relation("FileVersionUploader")
  lockedFiles          File[]         @relation("FileLockOwner")
  files                File[]         @relation("FileUploader")
  folders              Folder[]
  sharedLinks          SharedLink[]
  teams                TeamMember[]

  @@map("users")
}

model Team {
  id                  Int            @id @default(autoincrement())
  name                String
  description         String?
  owner_id            Int
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  invite_code         String?        @unique @db.VarChar(8)
  invite_code_enabled Boolean?       @default(true)
  activityLogs        ActivityLog[]
  announcements       Announcement[]
  comments            Comment[]
  files               File[]
  folders             Folder[]
  sharedLinks         SharedLink[]
  members             TeamMember[]

  @@map("teams")
}

model TeamMember {
  id         Int      @id @default(autoincrement())
  team_id    Int
  user_id    Int
  role       String   @default("viewer")
  created_at DateTime @default(now())
  team       Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

model Folder {
  id               Int       @id @default(autoincrement())
  team_id          Int
  parent_folder_id Int?
  name             String
  created_by       Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?
  is_deleted       Boolean   @default(false)
  files            File[]
  creator          User      @relation(fields: [created_by], references: [id])
  parent           Folder?   @relation("FolderChildren", fields: [parent_folder_id], references: [id])
  children         Folder[]  @relation("FolderChildren")
  team             Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("folders")
}

model File {
  id               Int           @id @default(autoincrement())
  team_id          Int
  folder_id        Int?
  filename         String
  original_name    String
  file_size        Int
  mime_type        String
  storage_path     String
  hash             String?
  uploaded_by      Int
  is_deleted       Boolean       @default(false)
  deleted_at       DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  lockOwnerUserId  Int?
  lockToken        String?       @db.VarChar(36)
  lockExpiresAt    DateTime?
  editingStartedAt DateTime?
  comments         Comment[]
  versions         FileVersion[]
  folder           Folder?       @relation(fields: [folder_id], references: [id])
  lockOwner        User?         @relation("FileLockOwner", fields: [lockOwnerUserId], references: [id])
  team             Team          @relation(fields: [team_id], references: [id], onDelete: Cascade)
  uploader         User          @relation("FileUploader", fields: [uploaded_by], references: [id])
  sharedLinks      SharedLink[]

  @@index([lockExpiresAt], map: "idx_files_lock_expiry")
  @@map("files")
}

model FileVersion {
  id             Int      @id @default(autoincrement())
  file_id        Int
  version_number Int
  storage_path   String
  file_size      Int
  uploaded_by    Int
  created_at     DateTime @default(now())
  file           File     @relation(fields: [file_id], references: [id], onDelete: Cascade)
  uploader       User     @relation("FileVersionUploader", fields: [uploaded_by], references: [id])

  @@map("file_versions")
}

model Comment {
  id         Int       @id @default(autoincrement())
  file_id    Int
  team_id    Int
  user_id    Int
  content    String
  resolved   Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  is_deleted Boolean   @default(false)
  file       File      @relation(fields: [file_id], references: [id], onDelete: Cascade)
  team       Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id])

  @@map("comments")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  team_id     Int?
  user_id     Int?
  action      String
  target_type String?
  target_id   Int?
  metadata    Json?
  ip          String?
  userAgent   String?
  created_at  DateTime @default(now())
  team        Team?    @relation(fields: [team_id], references: [id])
  user        User?    @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}

model SharedLink {
  id              Int       @id @default(autoincrement())
  file_id         Int?
  created_by      Int
  token           String    @unique
  password_hash   String?
  expiration_date DateTime?
  download_limit  Int?
  downloads_count Int       @default(0)
  created_at      DateTime  @default(now())
  team_id         Int
  creator         User      @relation(fields: [created_by], references: [id])
  file            File?     @relation(fields: [file_id], references: [id], onDelete: Cascade)
  team            Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("shared_links")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  teamId    Int
  authorId  Int
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model TokenBlacklist {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("token_blacklist")
}
